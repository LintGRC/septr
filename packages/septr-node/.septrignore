# Septr's own source contains intentional attack payloads used to:
#   - self-test adapters (src/adapters/*.ts verify blocks)
#   - fire the `septr test` command (src/cli.ts payloads)
#   - define detection patterns (src/core/sanitize.ts, ssrf.ts, etc.)
#   - probe path catalog (septr-checks/probe-paths.json)
# These are NOT vulnerabilities — excluding them is intentional.

# Test files exercise the detectors with real attack payloads
src/__tests__/
test/

# Probe-path catalog: URL paths that intentionally look like attack strings
septr-checks/probe-paths.json

# Detection pattern definitions — the attack strings ARE the product here
src/core/sanitize.ts
src/core/ssrf.ts

# Self-test engine: fires every detector with representative payloads
src/core/self-test.ts

# CLI `test` command embeds attack payloads; self-test blocks live in
# the adapters (inline, mixed with real middleware logic)
src/cli.ts
src/adapters/express.ts
src/adapters/fastify.ts
src/adapters/hono.ts
src/adapters/nextjs.ts